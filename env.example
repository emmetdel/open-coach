# OpenCoach Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# Garmin Credentials (Optional - can set in UI)
# ======================

# Your Garmin Connect login credentials
# Note: 2FA must be disabled on your Garmin account
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-garmin-password

# ======================
# Server Configuration
# ======================

# Port to expose the web app on (default: 3000)
PORT=3000

# Base URL for the application (used by cron jobs)
BASE_URL=http://localhost:3000

# ======================
# Database Configuration
# ======================

# Directory to store data (SQLite database)
DATA_DIR=./data

# Full path to SQLite database file
DATABASE_PATH=./data/opencoach.db

# ======================
# Scheduled Jobs
# ======================

# Enable cron jobs for automatic sync (default: true)
ENABLE_CRON=true

# Secret header for cron job endpoints (change in production!)
CRON_SECRET=change-me-in-production

# ======================
# AI Configuration (Optional - can set in UI)
# ======================

# OpenRouter API key for AI coaching feedback
# Get one at: https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# AI model to use (default: anthropic/claude-3.5-haiku)
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
