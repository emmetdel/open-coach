# OpenCoach Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# Garmin Credentials
# ======================

# Your Garmin Connect login credentials
# Note: 2FA must be disabled on your Garmin account
# If password contains $ characters, escape them with $$ (e.g., pa$$word)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ======================
# AI Configuration
# ======================

# OpenRouter API key for AI coaching feedback
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AI model to use (optional, defaults to anthropic/claude-sonnet-4)
# Other options: anthropic/claude-3.5-haiku, openai/gpt-4o, google/gemini-2.0-flash-exp
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ======================
# Server Configuration
# ======================

# Port to run the web server on
PORT=3000

# Base URL for the application (used for notifications and callbacks)
# Change this to your actual domain in production
BASE_URL=http://localhost:3000

# ======================
# Database Configuration
# ======================

# Directory to store persistent data (SQLite database)
DATA_DIR=./data

# Full path to SQLite database file
DATABASE_PATH=./data/opencoach.db

# ======================
# Push Notifications (Optional)
# ======================

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:your-email@example.com

# ======================
# Scheduled Jobs
# ======================

# Enable background cron jobs for automatic sync and reminders
ENABLE_CRON=true

# Secret token for cron job API endpoints (change in production!)
CRON_SECRET=change-me-in-production
