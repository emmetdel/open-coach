		"@types/node-cron": "^3.0.11",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"better-sqlite3": "^11.8.1",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"dotenv": "^16.4.7",
		"garmin-connect": "^1.6.2",
